# Copy into a private operator env file; do not commit real credentials.
# Use random hex so the same password is safe in the PostgreSQL URI.
FORGE_POSTGRES_PASSWORD=
FORGE_PUBLIC_URL=https://forge.example.com
FORGE_OIDC_ISSUER=https://identity.example.com/realms/forge
FORGE_OIDC_CLIENT_ID=skill-forge
FORGE_OIDC_CLIENT_SECRET=
